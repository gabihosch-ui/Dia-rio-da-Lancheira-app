# Copie para ".env" e preencha com os dados do projeto Supabase de DESENVOLVIMENTO
# (Supabase › Project Settings › API). O arquivo .env não vai para o Git.
#
# ATENÇÃO: use apenas a URL e a chave pública "anon" (ou "publishable").
# NUNCA coloque a chave service_role, a senha do banco ou qualquer segredo aqui:
# variáveis EXPO_PUBLIC_ ficam embutidas no app e podem ser lidas por qualquer pessoa.

EXPO_PUBLIC_SUPABASE_URL=https://SEU-PROJETO.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=cole-aqui-a-chave-anon
