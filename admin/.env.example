# Copie para .env.local. Apenas URL e chave pública (publishable) do Supabase do APP.
# Nunca coloque a chave secreta/service_role aqui: tudo que começa com VITE_PUBLIC_ vai para o navegador.
VITE_PUBLIC_SUPABASE_URL=https://SEU-PROJETO.supabase.co
VITE_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...
VITE_PUBLIC_ENVIRONMENT_LABEL=Desenvolvimento
